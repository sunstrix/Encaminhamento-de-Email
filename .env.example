# ==============================================================================
# SISTEMA DE ENCAMINHAMENTO DE EMAILS - CP FANI
# ==============================================================================
# INSTRUÇÕES:
# 1. Copie este arquivo para `.env` (PowerShell: Copy-Item .env.example .env)
# 2. Preencha as variáveis abaixo com suas credenciais reais.
# 3. NUNCA commite o arquivo `.env` no Git (ele já está no .gitignore).
#
# Este arquivo é a FONTE ÚNICA DE VERDADE das configurações.
# Toda variável listada aqui é lida por config/settings.py.
# Variáveis não listadas aqui NÃO SÃO LIDAS pelo sistema.
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. CONFIGURAÇÕES IMAP (Leitura de Emails - Conta de Origem)
# ------------------------------------------------------------------------------
# Para Gmail, é OBRIGATÓRIO usar "Senha de App" (não a senha normal).
# Para GoDaddy/Office365, use a senha da conta ou token OAuth.
# Link Gmail: https://myaccount.google.com/apppasswords

IMAP_SERVER=imap.secureserver.net
IMAP_PORT=993
IMAP_USER=alex@didier.com.br
IMAP_PASS=XXXX-XXXX-XXXX-XXXX


# ------------------------------------------------------------------------------
# 2. CONFIGURAÇÕES SMTP (Envio de Emails - Encaminhamento)
# ------------------------------------------------------------------------------
# Se a conta SMTP for DIFERENTE da IMAP, preencha SMTP_USER/SMTP_PASS.
# Se for a MESMA conta, você pode deixar SMTP_USER/SMTP_PASS em branco
# e o settings.py usará automaticamente IMAP_USER/IMAP_PASS (fallback).

SMTP_SERVER=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=


# ------------------------------------------------------------------------------
# 3. DESTINATÁRIOS E ROTAS DE APROVAÇÃO
# ------------------------------------------------------------------------------
# APPROVAL_EMAIL: quem recebe os emails para APROVAR/REJEITAR encaminhamentos.
#                 Se deixar em branco, o sistema usa SENDER_EMAIL ou IMAP_USER.
# FINANCEIRO_EMAIL: destinatário FINAL dos emails aprovados (obrigatório).
# ADMIN_EMAIL: recebe alertas de erro do sistema (opcional).

APPROVAL_EMAIL=alex@didier.com.br
FINANCEIRO_EMAIL=financeiro@didier.com.br
ADMIN_EMAIL=


# ------------------------------------------------------------------------------
# 4. REGRAS DE FILTRO E NEGÓCIO
# ------------------------------------------------------------------------------
# DOMAIN_APROVADOR: apenas emails vindos deste domínio podem aprovar/rejeitar.
# WHITELIST_SENDERS: remetentes SEMPRE aceitos (um por linha).
# BLACKLIST_SENDERS: remetentes SEMPRE bloqueados (um por linha).
# BLOCK_KEYWORDS: palavras no ASSUNTO que bloqueiam o email (uma por linha).

DOMAIN_APROVADOR=didier.com.br

WHITELIST_SENDERS=

BLACKLIST_SENDERS=
    lixo@didier.com.br
    notifications@didier.com.br
    alert@uptimerobot.com
    noreply_gol_seguranca@claro.com.br
    trocadechip.pme@claroatendimento.com.br
    no-reply@hetrixtools.com

BLOCK_KEYWORDS=
    contratação
    contratacao
    assinatura
    proposta
    agendamento
    pesquisa
    senha
    renovação
    renovacao
    reagendamento técnico
    reagendamento tecnico


# ------------------------------------------------------------------------------
# 5. CAMINHOS E ARMAZENAMENTO
# ------------------------------------------------------------------------------
# DB_FILE: banco SQLite com emails pendentes de aprovação.
# LOG_DIR: pasta onde os logs de execução são gravados.
# (Ambos são caminhos relativos ao diretório raiz do projeto.)

DB_FILE=./data/pending_emails.db
LOG_DIR=./logs


# ------------------------------------------------------------------------------
# 6. COMPORTAMENTO DO PIPELINE
# ------------------------------------------------------------------------------
# DRY_RUN: se "true", processa emails mas NÃO envia nada (modo teste).
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# POLL_INTERVAL_MINUTES: intervalo entre execuções quando rodando em modo contínuo.
# FORWARD_SUBJECT_PREFIX: texto adicionado no assunto dos emails encaminhados.

DRY_RUN=false
LOG_LEVEL=INFO
POLL_INTERVAL_MINUTES=60
FORWARD_SUBJECT_PREFIX=[CP FANI] ENC:


# ------------------------------------------------------------------------------
# 7. PRAZOS E EXPIRAÇÃO
# ------------------------------------------------------------------------------
# APPROVAL_REMINDER_HOURS: horas antes de expirar para enviar lembrete.
# APPROVAL_EXPIRE_DAYS: dias sem aprovação antes do email ser descartado.

APPROVAL_REMINDER_HOURS=24
APPROVAL_EXPIRE_DAYS=7


# ==============================================================================
# FIM DO ARQUIVO
# ==============================================================================
# Para testar a configuração: python config/settings.py
# Para rodar em modo teste:    $env:DRY_RUN="true"; python src/main.py
# ==============================================================================