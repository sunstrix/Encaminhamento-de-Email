# ==============================================================================
# SISTEMA DE ENCAMINHAMENTO DE EMAILS - CP FANI
# Arquivo: .env (PRODUCAO)
# ==============================================================================
# CRITICO: Este arquivo NUNCA deve ser commitado no GitHub.
# O .gitignore bloqueia o commit automaticamente.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. IMAP - LEITURA DA CAIXA (conta de origem)
# ------------------------------------------------------------------------------
IMAP_SERVER=imap.secureserver.net
IMAP_PORT=993
# IMPORTANTE: SEM ASPAS na senha! Aspas causam AUTHENTICATIONFAILED
IMAP_USER=alex@didier.com.br
IMAP_PASSWORD=@DiDier123
# Fallback para o settings.py (caso use EMAIL_USER/EMAIL_PASS)
EMAIL_USER=alex@didier.com.br
EMAIL_PASS=@DiDier123

# ------------------------------------------------------------------------------
# 2. SMTP - ENVIO (encaminhamentos, aprovacoes, relatorios)
# ------------------------------------------------------------------------------
# GoDaddy: 465 = SSL direto | 587 = STARTTLS
SMTP_SERVER=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=alex@didier.com.br
SMTP_PASSWORD=@DiDier123
SENDER_EMAIL=alex@didier.com.br
SENDER_NAME=CP FANI - Encaminhamento Automatico

# ------------------------------------------------------------------------------
# 3. DESTINOS E REGRAS DE APROVACAO
# ------------------------------------------------------------------------------
FINANCEIRO_EMAIL=financeiro@didier.com.br
ADMIN_EMAIL=alex@didier.com.br
# Email que RECEBE os botoes de aprovar/reprovar (pode ser o mesmo do admin)
APPROVAL_EMAIL=alex@didier.com.br
# Qualquer endereco deste dominio pode Aprovar/Reprovar
APPROVER_DOMAIN=didier.com.br
APPROVAL_REMINDER_HOURS=24
APPROVAL_TIMEOUT_DAYS=7

# ------------------------------------------------------------------------------
# 4. REGRAS DE FILTRO (WHITELIST / BLACKLIST / KEYWORDS)
# ------------------------------------------------------------------------------
# FORMATO: UMA LINHA, separado por virgula (sem espacos extras)
WHITELIST_SENDERS=

BLACKLIST_SENDERS=lixo@didier.com.br,notifications@didier.com.br,alert@uptimerobot.com,noreply_gol_seguranca@claro.com.br,trocadechip.pme@claroatendimento.com.br,no-reply@hetrixtools.com

BLOCK_KEYWORDS=contratacao,contratação,assinatura,proposta,agendamento,pesquisa,senha,renovacao,renovação,reagendamento tecnico,reagendamento técnico

# ------------------------------------------------------------------------------
# 5. JANELA DE COLETA E AGENDAS
# ------------------------------------------------------------------------------
START_DATE=2026-08-01
TIMEZONE=America/Sao_Paulo
EXECUTION_INTERVAL_MINUTES=60
# 5 = sexta-feira (0=domingo .. 6=sabado)
WEEKLY_REPORT_DAY=5
WEEKLY_REPORT_TIME=09:00
WEEKLY_ANALYZER_TIME=09:15
POLL_INTERVAL_MINUTES=60

# ------------------------------------------------------------------------------
# 6. CAMINHOS (relativos a raiz do projeto)
# ------------------------------------------------------------------------------
DATA_DIR=./data
LOG_DIR=./logs
DB_PATH=./data/pending_emails.db
DB_FILE=./data/pending_emails.db
BLACKLIST_FILE=./data/blacklist.txt
BASELINE_FILE=./data/emails_unicos.txt

# ------------------------------------------------------------------------------
# 7. MODOS DE OPERACAO
# ------------------------------------------------------------------------------
DRY_RUN=true
LOG_LEVEL=INFO